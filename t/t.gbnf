# t's surface notation as a grammar a generator can decode against (2026-09-18, WS-21).
#
# GBNF/EBNF, for xgrammar -- the backend vLLM uses for `structured_outputs.grammar`. A model decoding against
# this constrains structural syntax. Inline definitions additionally require source-level type/scope/
# acyclicity checks; a context-free grammar cannot enforce those semantic conditions.
#
# This file is not the definition of t. t/SYNTAX.md and t/surface.py are, and this only has to agree with them:
# t/grammar_check.py proves the agreement mechanically in both directions, and no arm of
# t/PREREG-2026-09-18-constrained.md may run until it does.
#
# Whitespace. Every keyword here is followed by at least one space, because in all 3,207 programs the parser
# has ever accepted the only keywords ever written against a symbol are `len(`, `tostr(` and `seq(`, which are
# written as such below. That keeps the grammar from admitting `xandy`, which this file's alternation would
# otherwise read as `x and y` while the lexer reads one identifier.
#
# Identifiers. GBNF has no negative lookahead, so "a word that is not a keyword" is generated rather than
# written: t/make_grammar.py turns surface.KEYWORDS into a trie and writes the rules at the end of this file.
# Without it the grammar admits `var int : int := 0`, which the parser refuses -- measured, 1 reply in 200.

root ::= ws (datatype ws)* task ws

# `datatype D = C1 | C2 | ...` before the `t N` line (SPEC.md "Datatypes (v1)", 2026-09-27)
datatype ::= "datatype" sp id ws "=" ws id (ws "|" ws id)*

task ::= "t" sp ver sp gatepart "task" sp id ws params ws "returns" ws "(" ws id ws ":" ws type ws ")" clauses specfuns ws block
ver ::= "0" | "1"
gatepart ::= "" | "gate" sp id sp
clauses ::= clause*
clause ::= ws ("requires" | "ensures" | "decreases") sp expr
specfuns ::= (specfun | inlinefun)*
specfun ::= ws "spec" sp "fun" sp id ws params ws ":" ws type ws "decreases" sp expr ws "=" ws expr
inlinefun ::= ws "inline" sp "fun" sp id ws params ws ":" ws type ws "=" ws expr semi

params ::= "(" ws paramlist ws ")"
paramlist ::= "" | param (ws "," ws param)*
param ::= id ws ":" ws type

# int | bool | seq | seq<T> | set | set<T> | (T1, T2) | (T1, ..., Tn) | a declared datatype's name
# (SPEC.md "Compositional types (v1)", 2026-10-06; seq<int> and set<int> are spelled seq and set)
type ::= "seq" (ws "<" ws type ws ">")? | "set" (ws "<" ws type ws ">")? | "int" | "bool" | "real"
       | "(" ws type (ws "," ws type)+ ws ")" | id

block ::= "{" ws stmts "}"
stmts ::= (stmt ws)*
stmt ::= "return" sp expr semi
       | "var" sp id ws ":" ws type ws ":=" ws expr semi
       | "if" sp expr ws block (ws "else" ws block)?
       | "while" sp expr invariants ws "decreases" sp expr ws block
       | "for" sp id (ws "," ws id)? sp "in" sp ("[" ws expr ws "," ws expr ws ")" | expr) invariants ws block
       | id ws ":=" ws expr semi
invariants ::= (ws "invariant" sp expr)*
semi ::= ws ";" | ""

# Expressions, lowest binding first, exactly t/surface.py's ladder. Quantifiers and if/then/else run to the
# right as far as they can, which is why they sit above implies rather than beside the atoms.
expr ::= quant | ite | implies
quant ::= ("forall" | "exists") sp id sp "in" sp "[" ws expr ws "," ws expr ws ")" ws "." ws expr
ite ::= "if" sp expr sp "then" sp expr sp "else" sp expr
implies ::= disj (ws "==>" ws (quant | ite | implies))?
disj ::= conj (sp "or" sp conj)*
conj ::= neg (sp "and" sp neg)*
neg ::= "not" sp neg | cmp
# comparisons do not chain: at most one, and never a second beside it
# `x in s` sits at the comparison level and does not chain (SPEC.md "Finite sets", 2026-09-27)
cmp ::= sum (ws cmpop ws sum)? | sum sp "in" sp sum
cmpop ::= "==" | "!=" | "<=" | ">=" | "<" | ">"
sum ::= prod (ws sumop ws prod)*
sumop ::= "+" | "-"
prod ::= unary (ws prodop ws unary)*
prodop ::= "*" | "/" | "%"
unary ::= "-" ws unary | postfix
postfix ::= atom posts
posts ::= (ws post)*
post ::= "[" ws ".." ws expr ws "]"
       | "[" ws expr ws ".." ws expr ws "]"
       | "[" ws expr ws ".." ws "]"
       | "[" ws expr ws ":=" ws expr ws "]"
       | "[" ws expr ws "]"
       | "." nat
       | "." strmember ws "(" ws args ws ")"
strmember ::= "split" | "join" | "count" | "find" | "startswith" | "endswith" | "replace"
            | "strip" | "lstrip" | "rstrip" | "lower" | "upper"
            | "isdigit" | "isalpha" | "isupper" | "islower"

atom ::= reallit
       | nat
       | charlit
       | strlit
       | "true"
       | "false"
       | "len" ws "(" ws expr ws ")"
       | "seq" ws "(" ws expr ws "," ws expr ws ")"
       | "tostr" ws "(" ws expr ws ")"
       | ("real" | "floor" | "ceil") ws "(" ws expr ws ")"
       | "card" ws "(" ws expr ws ")"
       | ("union" | "inter" | "setminus") ws "(" ws expr ws "," ws expr ws ")"
       | "{" ws args ws "}"
       | "case" sp expr ws "{" ws arm (ws "," ws arm)* ws "}"
       | id ws "." ws id
       | "(" ws expr (ws "," ws expr)+ ws ")"
       | "(" ws expr ws ")"
       | "[" ws args ws "]"
       | id ws "(" ws args ws ")"
       | id
args ::= "" | expr (ws "," ws expr)*
arm ::= id ws "=>" ws expr

nat ::= [0-9]+
# SPEC.md "Exact rationals (v1)" (2026-10-06): a finite decimal with a digit on each side of the point
reallit ::= [0-9]+ "." [0-9]+

charlit ::= "'" charbody "'"
charbody ::= [^'\\\r\n] | esc
strlit ::= "\"" strbody "\""
strbody ::= ([^"\\\r\n] | esc)*
esc ::= "\\" ("n" | "t" | "r" | "0" | "'" | "\"" | "\\") | "\\u{" hex+ "}"
hex ::= [0-9a-fA-F]

ws ::= [ \t\r\n]*
sp ::= [ \t\r\n]+

# BEGIN generated by t/make_grammar.py -- an identifier is a word that is not a keyword
