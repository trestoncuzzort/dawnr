-- t task 'abs' -> lean4, generated by lower_lean.py; every verdict is the kernel's.

def abs_t (x : Int) : Int :=
  (if _h1 : (x < (0 : Int)) then (-x) else x)

theorem abs_t_spec (x : Int) :
    ((abs_t x) ≥ (0 : Int))
    ∧ (((abs_t x) = x) ∨ ((abs_t x) = (-x))) := by
  first
  | (try unfold abs_t
     grind)
  | grind [abs_t]

