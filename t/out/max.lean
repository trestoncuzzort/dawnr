-- t task 'max' -> lean4, generated by lower_lean.py; every verdict is the kernel's.

def max_t (x : Int) (y : Int) : Int :=
  (if _h1 : (x ≥ y) then x else y)

theorem max_t_spec (x : Int) (y : Int) :
    ((max_t x y) ≥ x)
    ∧ ((max_t x y) ≥ y)
    ∧ (((max_t x y) = x) ∨ ((max_t x y) = y)) := by
  first
  | (try unfold max_t
     grind)
  | grind [max_t]

