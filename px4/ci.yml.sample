# Sample CI — rename into .github/workflows/ (PX4 repo) or a dawnr workflow to enable.
# Fails the build if any PX4 safety invariant proof stops reproducing, or a modeled function drifts.
name: dawnr-px4-formal-gates
on:
  pull_request:
    paths: [ "src/modules/rc_update/**", "src/lib/mathlib/**", "src/lib/mixer_module/**", "px4/**" ]
jobs:
  gates:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Provision dawnr + a prover   # simplest: run inside a dawnr container image
        run: echo "TODO: install dawnr + gnatprove (or Dafny), or use a dawnr container"
      - name: Source drift (re-review models if a modeled PX4 function changed)
        run: ./px4/dawnr-px4 drift
      - name: Replay the proofs (no model; fails if an invariant broke)
        run: ./px4/dawnr-px4 verify
