# Linux 6.18.60 desktop wired network/firewall and early microcode floor.
# Merge after x86_64_defconfig and tup/boot/kernel.py fragment.
# nft_counter, meta, lookup, payload and verdicts are nf_tables core objects.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PCI=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_FW_LOADER=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_MICROCODE=y
CONFIG_R8169=m
# CONFIG_MICROCODE_LATE_LOADING is not set
