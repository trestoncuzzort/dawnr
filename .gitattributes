data/*.jsonl merge=union
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
# t/: the lowered sources and tables are hashed as the verdict basis, so a
# checkout must not change their bytes. autocrlf=true on Windows turned the
# committed out/ fixtures CRLF and their hashes with them (2026-09-02).
t/** text=auto eol=lf

# nl/: imported problem corpora. Gzipped JSONL, 918 MB, too big for git proper.
nl/data/*.jsonl.gz filter=lfs diff=lfs merge=lfs -text
