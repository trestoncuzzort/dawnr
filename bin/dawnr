#!/usr/bin/env bash
# dawnr: an assistant on this machine, offline, and every check behind it as a command of its own.
#
#   dawnr                 the assistant, in the folder you are in: it reads your files, changes them only as a plan
#                         you were shown, and runs a few commands in a sandbox [--read-only] [--root DIR] [--online] [--yes]
#   dawnr do "TASK"       one task for the assistant, then back to the shell (the same options)
#   dawnr prove SPEC.t    a specification you wrote: the model writes the body, the provers decide [--test ...] [--save-python FILE]
#   dawnr spec "QUESTION" --test "assert f(x) == y" [--save SPEC.t]    specifications to read and pick from
#   dawnr ask "Write a function that doubles a number." --test "assert double(3) == 6" [--test ...] [--save-python FILE]
#   dawnr verify FILE.py  a Python function you already have: a proved twin of it, or why not [--fn NAME] [--test ...]
#   dawnr extract FILE... --field "total(number): the amount due"    fields from your files, each with the sentence it is in
#   dawnr cite "QUESTION" FILE...    an answer from your files, every claim quoting one of their sentences
#   dawnr calc "QUESTION WITH NUMBERS"    the number reasoned in words, shown when a working computed exactly gives it too
#   dawnr tools TOOLS.json "REQUEST"    your tools offered to the model; a call is shown only when its values were said
#   dawnr check FILE      replay a certificate (ask or prove with --certificate FILE wrote it): no model, this machine's provers
#   dawnr doctor          what is installed and what each part found
#   dawnr forget          erase what dawnr kept about your work here: the journal, the jobs, the run folder (PRIVACY.md) [--all]
#   dawnr serve start     keep the two model servers running between questions (faster); serve stop / serve status
#   dawnr ui              all of the above as a page, opened in your browser (this machine only; no terminal needed after this)
#   dawnr serve api       the same page and a local HTTP API, without opening a browser
#   dawnr mcp             the checks as tools for the assistant you already use (Model Context Protocol, stdio)
#
# Installed by install.sh. From a specification the gate is t/prove.py: a body counts only if it keeps the specification
# and is proved. From a question it is t/answer.py: the model answers, the answers that pass the tests are checked
# against an independent Python solution, then proved; one is shown with its evidence, or the question is refused.
set -euo pipefail
ENVF=${DAWNR_HOME:-$HOME/.local/share/dawnr}/env
[ -f "$ENVF" ] || { echo "dawnr: not installed yet; run install.sh from the dawnr folder" >&2; exit 1; }
set -a; . "$ENVF"; set +a
CORES=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
THREADS=${DAWNR_THREADS:-$(( CORES > 2 ? CORES / 2 : 1 ))}
# Writing a token reads every weight once, so it is bound by memory, not by cores: on a 12-core desktop the 4B wrote
# 17.2, 17.4, 16.6 and 15.9 tokens a second on 3, 6, 8 and 12 threads, while reading a prompt went from 148 to 234 a
# second from 6 threads to 12 (llama-bench, 2026-10-05). So: few threads to write, all the cores to read.
GEN_THREADS=${DAWNR_GEN_THREADS:-$(( THREADS > 6 ? 6 : THREADS ))}
SP=${DAWNR_STUDENT_PORT:-8711}; BP=${DAWNR_BASE_PORT:-8712}
# the base model's window: the assistant's tools, the files it reads and its plans share it (4,096 held three steps)
BASE_CTX=${DAWNR_BASE_CTX:-16384}
RUN=$DAWNR_HOME/run; mkdir -p "$RUN"

healthy() { curl -s -m 2 "http://127.0.0.1:$1/health" 2>/dev/null | grep -q '"ok"'; }

# A writer other than the installed model (optional). The program may be written by any model behind an
# OpenAI-compatible address, a larger one on a machine of yours or a hosted one; the tests, the independently written
# Python, the provers and the certificate stay on this machine, and nothing the writer returns is relied on unchecked.
#   DAWNR_WRITER_URL=https://host/v1  DAWNR_WRITER_MODEL=name  [DAWNR_WRITER_KEY=key]
WRITER=(); STUDENT_AT=127.0.0.1:$SP
if [ -n "${DAWNR_WRITER_URL:-}" ]; then
  [ -n "${DAWNR_WRITER_MODEL:-}" ] || { echo "dawnr: DAWNR_WRITER_URL needs DAWNR_WRITER_MODEL, the model's name at that address" >&2; exit 2; }
  export T_API_KEY=${DAWNR_WRITER_KEY:-${T_API_KEY:-}}
  export DAWNR_WRITER="$DAWNR_WRITER_MODEL at ${DAWNR_WRITER_URL#*://}"
  WRITER=(--student-name "$DAWNR_WRITER_MODEL" --reference --max-new 3072); STUDENT_AT=$DAWNR_WRITER_URL
fi
sent_away() {  # said every time: with a writer elsewhere, what is asked leaves this machine
  [ -z "${DAWNR_WRITER_URL:-}" ] || echo "dawnr: this is sent to $DAWNR_WRITER to be written; what comes back is checked here, and none of it is trusted unchecked." >&2
}

# --cache-ram 256: llama-server keeps up to 8 GiB of old prompts in RAM by default, a speed feature for switching
# between prompts (github.com/ggml-org/llama.cpp/pull/16391); dawnr repeats one prompt, which the slot reuses anyway,
# and the default pushed the student's server to 10.8 GB (measured 2026-10-02)
start_both() {  # the student, then the base: on a GPU build the base waits for the student to hold its memory
  start_one student "$STUDENT_GGUF" "$SP"
  if [ "${DAWNR_BUILD:-cpu}" != cpu ]; then
    for _ in $(seq 1 "${DAWNR_START_SECONDS:-600}"); do healthy "$SP" && break; sleep 1; done
  fi
  start_one base "$BASE_GGUF" "$BP"                                # beside the student, the base keeps the small window
}

on_card() { [ "${DAWNR_BUILD:-cpu}" != cpu ] && [ "${DAWNR_GPU_LAYERS:-}" != 0 ]; }
stop_one() {  # name port
  if [ -f "$RUN/$1.pid" ]; then kill "$(cat "$RUN/$1.pid")" 2>/dev/null || true; fi
  rm -f "$RUN/$1.pid" "$RUN/$1.ctx"
  for _ in $(seq 1 20); do healthy "$2" || break; sleep 0.5; done
}

start_one() {  # name gguf port [context] [seconds idle before the model is unloaded]
  healthy "$3" && return 0
  [ -s "$2" ] || { echo "dawnr: the $1 model is missing ($2); run install.sh" >&2; exit 1; }
  # The base model drafts with its own prediction layer where the installer added it to the file
  # (locallm/gguf_layer.py): the layer guesses the next tokens and the model checks them in one pass, so what is
  # written is the model's own and comes sooner. Measured 2026-10-05 on the assistant's tasks, the same tasks done:
  # 16.8 to 29.4 tokens a second on a 12-core CPU, 55 to 72 on a laptop's 8 GB card. On a card it takes 0.35 GB
  # more, so there it is used when the base runs alone with the large window, and not beside the student, where
  # the two models were measured to fill 7.6 of 8 GB. DAWNR_DRAFT=0 turns it off.
  local draft=()
  if [ "$1" = base ] && [ "${DAWNR_DRAFT:-1}" != 0 ] && [ "${BASE_DRAFT:-}" = mtp ] && { ! on_card || [ "${4:-4096}" -gt 4096 ]; }; then
    draft=(--spec-type draft-mtp --spec-draft-n-max 6 --spec-draft-p-min 0.6)   # 6: 17.7 tokens/s against 15.8 at 5 and 12.0 at 3 on six CPU cores, 8 fell back to 16.1 (PREDICT S2, S2b)
  fi
  # DAWNR_GPU_LAYERS: how many layers llama.cpp puts on the GPU (unset: its own choice; 0: CPU only)
  LD_LIBRARY_PATH="$(dirname "$LLAMA_SERVER"):${LD_LIBRARY_PATH:-}" \
  nohup "$LLAMA_SERVER" --model "$2" --host 127.0.0.1 --port "$3" --threads "$GEN_THREADS" --threads-batch "$THREADS" \
    ${DAWNR_GPU_LAYERS:+--n-gpu-layers "$DAWNR_GPU_LAYERS"} ${draft[@]+"${draft[@]}"} ${5:+--sleep-idle-seconds "$5"} \
    --ctx-size "${4:-4096}" --parallel 1 --reasoning off --cache-ram 256 --slot-save-path "$RUN" --no-webui > "$RUN/$1.log" 2>&1 < /dev/null &
  echo $! > "$RUN/$1.pid"; echo "${4:-4096}" > "$RUN/$1.ctx"
}

wait_ready() {  # a first start on a small machine loads 7 GB and compiles its kernels: GitHub's 3-core Mac took over 3 minutes
  local limit=${DAWNR_START_SECONDS:-600} i n pid
  for i in $(seq 1 "$limit"); do
    healthy "$SP" && healthy "$BP" && return 0
    for n in student base; do
      pid=$(cat "$RUN/$n.pid" 2>/dev/null || true)
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        echo "dawnr: the $n model server stopped while loading; the end of $RUN/$n.log:" >&2; tail -5 "$RUN/$n.log" >&2; return 1
      fi
    done
    [ $((i % 60)) = 0 ] && echo "  still loading the models ($i s)..." >&2
    sleep 1
  done
  echo "dawnr: the model servers did not come up in $limit s; see $RUN/*.log" >&2; return 1
}

stop_all() {
  for n in student base; do
    if [ -f "$RUN/$n.pid" ]; then kill "$(cat "$RUN/$n.pid")" 2>/dev/null || true; rm -f "$RUN/$n.pid"; fi
    rm -f "$RUN/$n.ctx"
  done
}

sandbox_check() {  # prints why model-written Python cannot be sandboxed here, and fails; silent when it can
  (cd "$DAWNR_REPO" && "$DAWNR_PYTHON" -c 'import sys; sys.path.insert(0, "t"); import py_sandbox
ok = py_sandbox.available(); ok or print(py_sandbox.why_unavailable()); sys.exit(0 if ok else 1)')
}

abspath() { case $1 in /*) printf '%s' "$1";; *) printf '%s/%s' "$PWD" "$1";; esac; }

# the options that name a file are the caller's paths; the gate runs from the repository's folder
own_paths() {
  ARGS=()
  while [ $# -gt 0 ]; do
    case $1 in
      --save-python|--save-t|--save|--json|--certificate|--spec) [ $# -ge 2 ] || { echo "dawnr: $1 needs a file name" >&2; exit 2; }
        ARGS+=("$1" "$(abspath "$2")"); shift 2;;
      *) ARGS+=("$1"); shift;;
    esac
  done
}

both_up() {  # start the two models if they are not running, and stop them again on the way out
  if [ -n "${DAWNR_WRITER_URL:-}" ]; then base_up; return 0; fi   # the writer is elsewhere: only the base runs here
  started=0
  # the assistant leaves the base model loaded with its large window; on a card the student does not fit beside that
  if on_card && ! healthy "$SP" && healthy "$BP" && [ "$(cat "$RUN/base.ctx" 2>/dev/null || echo 4096)" -gt 4096 ]; then
    echo "reloading the base model with its small window, so that both models fit the card..." >&2
    stop_one base "$BP"
  fi
  if ! { healthy "$SP" && healthy "$BP"; }; then
    echo "starting the models (half a minute here, a few minutes the first time on a small machine)..." >&2
    # on the way out only what this command started is stopped: a base model the assistant left loaded stays
    local had_student=0 had_base=0
    healthy "$SP" && had_student=1; healthy "$BP" && had_base=1
    start_both; started=1
    trap "[ $had_student = 1 ] || stop_one student $SP; [ $had_base = 1 ] || stop_one base $BP" EXIT
    wait_ready
  fi
}

student_up() {  # only the model that writes t: start it if it is not running, and stop it again on the way out
  started=0
  [ -z "${DAWNR_WRITER_URL:-}" ] || return 0
  if ! healthy "$SP"; then
    echo "starting the model (a quarter of a minute here, longer the first time on a small machine)..." >&2
    start_one student "$STUDENT_GGUF" "$SP"; started=1
    trap '[ $started = 1 ] && stop_all' EXIT
    for _ in $(seq 1 "${DAWNR_START_SECONDS:-600}"); do healthy "$SP" && break; sleep 1; done
    healthy "$SP" || { echo "dawnr: the model did not come up; see $RUN/student.log" >&2; exit 1; }
  fi
}

base_up() {  # only the base model, for what is answered from the person's files
  started=0
  if ! healthy "$BP"; then
    echo "starting the base model..." >&2
    start_one base "$BASE_GGUF" "$BP" "$BASE_CTX"; started=1
    trap '[ $started = 1 ] && stop_all' EXIT
    for _ in $(seq 1 "${DAWNR_START_SECONDS:-600}"); do healthy "$BP" && break; sleep 1; done
    healthy "$BP" || { echo "dawnr: the base model did not come up; see $RUN/base.log" >&2; exit 1; }
  fi
}

# no command, in a terminal: the assistant. Its own options may come first (`dawnr --read-only`).
case ${1:-} in
  "") [ -t 0 ] && cmd=assistant || cmd=help;;
  --read-only|--root|--online|--yes) cmd=assistant;;
  *) cmd=$1; shift;;
esac
case $cmd in
  assistant|do)
    # locallm/dawnr_cli.py over the agent and the harness (DAWNR-AGENT.md). It works in the caller's folder, so
    # nothing here changes directory; only the base model runs
    [ "$cmd" = assistant ] || [ $# -ge 1 ] || { echo 'usage: dawnr do "TASK" [--read-only] [--root DIR] [--online] [--yes]' >&2; exit 2; }
    # The model stays loaded after the assistant leaves, so the next task starts at once, and unloads itself after
    # a quarter of an hour unused (DAWNR_IDLE seconds; `dawnr serve stop` unloads it now)
    if healthy "$BP" && [ "$(cat "$RUN/base.ctx" 2>/dev/null || echo 4096)" -lt "$BASE_CTX" ]; then
      if healthy "$SP"; then
        echo "dawnr: both models are loaded, so the base model keeps its small window; \`dawnr serve stop\` first gives the assistant the large one" >&2
      else stop_one base "$BP"; fi
    fi
    if ! healthy "$BP"; then
      echo "starting the base model (it stays loaded for the next task, and unloads itself when idle)..." >&2
      start_one base "$BASE_GGUF" "$BP" "$BASE_CTX" "${DAWNR_IDLE:-900}"
      for _ in $(seq 1 "${DAWNR_START_SECONDS:-600}"); do healthy "$BP" && break; sleep 1; done
      healthy "$BP" || { echo "dawnr: the base model did not come up; see $RUN/base.log" >&2; exit 1; }
    fi
    # The system-and-tools prefix processed alone first (locallm/dawnr_warm.py): the server then takes the task's
    # first call up from a checkpoint at the prefix's end instead of processing the 2,200 tokens again (19 s on six
    # CPU cores, measured). One cheap request when the checkpoint is still there; never a reason to stop
    "$DAWNR_PYTHON" "$DAWNR_REPO/locallm/dawnr_warm.py" --host "127.0.0.1:$BP" --cwd "$PWD" "$@" 2>/dev/null || true
    "$DAWNR_PYTHON" "$DAWNR_REPO/locallm/dawnr_cli.py" --host "127.0.0.1:$BP" --cwd "$PWD" "$@"
    ;;
  prove)
    [ $# -ge 1 ] && [ "${1#--}" = "$1" ] || { echo 'usage: dawnr prove SPEC.t [--test "assert f(x) == y" ...] [--answers N] [--save-python FILE] [--save-t FILE] [--certificate FILE]' >&2; exit 2; }
    [ -f "$1" ] || { echo "dawnr: no such file: $1" >&2; exit 2; }
    SPEC=$(abspath "$1"); shift
    own_paths "$@"
    student_up; sent_away
    cd "$DAWNR_REPO"
    T_MIN_KERNELS=${T_MIN_KERNELS:-1} "$DAWNR_PYTHON" t/prove.py prove --student "$STUDENT_AT" ${WRITER[@]+"${WRITER[@]}"} --spec "$SPEC" ${ARGS[@]+"${ARGS[@]}"}
    ;;
  spec)
    [ $# -ge 1 ] && [ "${1#--}" = "$1" ] || { echo 'usage: dawnr spec "QUESTION" --test "assert f(x) == y" [--test ...] [--save SPEC.t]' >&2; exit 2; }
    QUESTION=$1; shift
    own_paths "$@"
    why=$(sandbox_check) || { echo "dawnr: model-written Python only runs in a sandbox, and $why" >&2; exit 1; }
    both_up; sent_away
    cd "$DAWNR_REPO"
    "$DAWNR_PYTHON" t/prove.py spec --student "$STUDENT_AT" ${WRITER[@]+"${WRITER[@]}"} --python "127.0.0.1:$BP" --text "$QUESTION" ${ARGS[@]+"${ARGS[@]}"}
    ;;
  ask)
    [ $# -ge 1 ] && [ "${1#--}" = "$1" ] || { echo 'usage: dawnr ask "QUESTION" --test "assert f(x) == y" [--test ...] [--save-python FILE] [--certificate FILE]' >&2; exit 2; }
    QUESTION=$1; shift
    own_paths "$@"
    why=$(sandbox_check) || { echo "dawnr: model-written Python only runs in a sandbox, and $why" >&2; exit 1; }
    both_up; sent_away
    cd "$DAWNR_REPO"
    # --consistency 5: five more Python solutions sampled at 0.8 must not find the specification false
    # (t/PREDICT-2026-10-02-ambiguity.md: 80% -> 87% of shown answers right); a later --consistency overrides it
    T_MIN_KERNELS=${T_MIN_KERNELS:-1} "$DAWNR_PYTHON" t/answer.py --student "$STUDENT_AT" ${WRITER[@]+"${WRITER[@]}"} --python "127.0.0.1:$BP" \
      --consistency 5 --text "$QUESTION" ${ARGS[@]+"${ARGS[@]}"}
    ;;
  verify)
    # a Python function the person already has: the model writes a specification and a t twin of it, and the function
    # itself (run in the sandbox) and the provers decide (t/verify_py.py); only the model that writes t is needed
    [ $# -ge 1 ] && [ "${1#--}" = "$1" ] || { echo 'usage: dawnr verify FILE.py [--fn NAME] [--test "assert f(x) == y" ...] [--save-t FILE] [--save-python FILE] [--certificate FILE]' >&2; exit 2; }
    [ -f "$1" ] || { echo "dawnr: no such file: $1" >&2; exit 2; }
    FILE=$(abspath "$1"); shift
    own_paths "$@"
    why=$(sandbox_check) || { echo "dawnr: your Python only runs in a sandbox here, and $why" >&2; exit 1; }
    student_up; sent_away
    cd "$DAWNR_REPO"
    T_MIN_KERNELS=${T_MIN_KERNELS:-1} "$DAWNR_PYTHON" t/verify_py.py --student "$STUDENT_AT" ${WRITER[@]+"${WRITER[@]}"} --file "$FILE" ${ARGS[@]+"${ARGS[@]}"}
    ;;
  calc)
    # a question with numbers: the model reasons its way to a number in words, writes the working separately, the
    # working is computed exactly, and the number is shown only when the two agree (locallm/calc.py); only the base
    # model is needed
    [ $# -ge 1 ] && [ "${1#--}" = "$1" ] || { echo 'usage: dawnr calc "QUESTION WITH NUMBERS" [--ways N] [--needed N] [--json OUT.json]' >&2; exit 2; }
    QUESTION=$1; shift
    own_paths "$@"
    base_up
    cd "$DAWNR_REPO" && "$DAWNR_PYTHON" locallm/calc.py --host "127.0.0.1:$BP" ${ARGS[@]+"${ARGS[@]}"} "$QUESTION"
    ;;
  tools)
    # a person's tools offered to the base model: a call it writes is shown only when every value it passes was said
    # in the request or is the tool's own default or choice; otherwise the question that names the parameter
    # (locallm/tool_check.py)
    [ $# -ge 2 ] && [ "${1#--}" = "$1" ] && [ "${2#--}" = "$2" ] || { echo 'usage: dawnr tools TOOLS.json "REQUEST" [--any-enum] [--json OUT.json]' >&2; exit 2; }
    [ -f "$1" ] || { echo "dawnr: no such file: $1" >&2; exit 2; }
    TOOLS=$(abspath "$1"); REQUEST=$2; shift 2
    own_paths "$@"
    base_up
    cd "$DAWNR_REPO" && "$DAWNR_PYTHON" locallm/tool_check.py --host "127.0.0.1:$BP" --tools "$TOOLS" ${ARGS[@]+"${ARGS[@]}"} "$REQUEST"
    ;;
  mcp)
    # dawnr's checks as Model Context Protocol tools on stdio, for an assistant that is not dawnr's (t/mcp_gate.py):
    # no model runs, and nothing but protocol messages may go to stdout
    cd "$DAWNR_REPO"
    T_MIN_KERNELS=${T_MIN_KERNELS:-1} exec "$DAWNR_PYTHON" t/mcp_gate.py
    ;;
  check)
    # a certificate replayed: the tests, the provers on this machine, the Python and the measurements, with no model
    # (t/certificate.py); exit 0 reproduced, 1 failed, 2 nothing here could decide
    [ $# -ge 1 ] && [ "${1#--}" = "$1" ] || { echo 'usage: dawnr check CERTIFICATE.json [--spec SPEC.t] [--json REPORT.json]' >&2; exit 2; }
    [ -f "$1" ] || { echo "dawnr: no such file: $1" >&2; exit 2; }
    CERT=$(abspath "$1"); shift
    own_paths "$@"
    cd "$DAWNR_REPO"
    T_MIN_KERNELS=${T_MIN_KERNELS:-1} "$DAWNR_PYTHON" t/certificate.py check "$CERT" ${ARGS[@]+"${ARGS[@]}"}
    ;;
  cite)
    # an answer from the person's own files, every claim quoting one of their sentences word for word, or a plain
    # "not in your files" (locallm/cite_docs.py); only the base model is needed
    [ $# -ge 2 ] && [ "${1#--}" = "$1" ] || { echo 'usage: dawnr cite "QUESTION" FILE [FILE ...]' >&2; exit 2; }
    QUESTION=$1; shift
    FILES=(); for f in "$@"; do FILES+=("$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"); done
    base_up
    cd "$DAWNR_REPO" && "$DAWNR_PYTHON" locallm/cite_docs.py --host "127.0.0.1:$BP" "$QUESTION" "${FILES[@]}"
    ;;
  extract)
    # fields out of the person's own files, each value a run of words of one of their sentences, shown with it, or
    # left empty (locallm/extract_docs.py); only the base model is needed
    ARGS=(); fields=0; files=0
    while [ $# -gt 0 ]; do
      case $1 in
        --field) [ $# -ge 2 ] || { echo "dawnr: --field needs \"name: what it is\"" >&2; exit 2; }
          ARGS+=("$1" "$2"); fields=$((fields + 1)); shift 2;;
        --json) [ $# -ge 2 ] || { echo "dawnr: --json needs a file name" >&2; exit 2; }
          ARGS+=("$1" "$(abspath "$2")"); shift 2;;
        --*) echo "dawnr: extract does not know $1" >&2; exit 2;;
        *) [ -f "$1" ] || { echo "dawnr: no such file: $1" >&2; exit 2; }
          ARGS+=("$(abspath "$1")"); files=$((files + 1)); shift;;
      esac
    done
    [ $fields -ge 1 ] && [ $files -ge 1 ] || { echo 'usage: dawnr extract FILE [FILE ...] --field "name: what it is" [--field "total(number): ..."] [--field "due(date): ..."] [--json OUT.json]' >&2; exit 2; }
    base_up
    cd "$DAWNR_REPO" && "$DAWNR_PYTHON" locallm/extract_docs.py --host "127.0.0.1:$BP" "${ARGS[@]}"
    ;;
  serve)
    case ${1:-status} in
      start) start_both; wait_ready && echo "the models are up";;
      stop) stop_all; echo "stopped";;
      status) for p in "$SP" "$BP"; do healthy "$p" && echo "port $p: up" || echo "port $p: down"; done;;
      api)
        # the same gate behind a local HTTP API, and a page in the browser over it (t/serve_api.py): loopback only,
        # a token made at start; the models stay up while it runs and stop with it if this started them
        both_up; sent_away
        cd "$DAWNR_REPO"
        "$DAWNR_PYTHON" t/serve_api.py --student "$STUDENT_AT" ${DAWNR_WRITER_MODEL:+--writer "$DAWNR_WRITER_MODEL"} --base "127.0.0.1:$BP" --port "${DAWNR_API_PORT:-8713}" --home "$DAWNR_HOME" "${@:2}"
        ;;
      *) echo "dawnr serve start|stop|status|api" >&2; exit 2;;
    esac;;
  ui)
    # the page, opened in the person's browser: `serve api`, and the browser handed a file only its owner can read
    # that sends it on to the page (t/serve_api.py, open_page)
    exec "$0" serve api --open
    ;;
  forget)
    # Everything dawnr kept about the person's work on this machine (PRIVACY.md lists it): the agent's journal and
    # state, the API's jobs (the text and files given to the page), the run folder (logs, pids, the page's token).
    # --all also erases the models and everything install.sh fetched; the launcher then needs install.sh again.
    [ $# -eq 0 ] || [ "${1:-}" = --all ] || { echo 'usage: dawnr forget [--all]' >&2; exit 2; }
    stop_all 2>/dev/null || true
    case $(uname -s) in
      Darwin) STATE="$HOME/Library/Application Support/dawnr-agent";;
      *) STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dawnr-agent";;
    esac
    gone=0
    for d in "$STATE" "$DAWNR_HOME/jobs" "$DAWNR_HOME/run"; do
      [ -e "$d" ] || continue
      rm -rf -- "$d" && echo "erased $d" && gone=$((gone + 1))
    done
    if [ "${1:-}" = --all ]; then
      for d in "$DAWNR_HOME/models" "$DAWNR_HOME/downloads" "$DAWNR_HOME/llama.cpp" "$DAWNR_HOME/provers" "$DAWNR_HOME/pylib" "$DAWNR_HOME/env"; do
        [ -e "$d" ] || continue
        rm -rf -- "$d" && echo "erased $d" && gone=$((gone + 1))
      done
      echo "the models and what install.sh fetched are gone; run install.sh again before the next dawnr command"
    fi
    [ $gone -gt 0 ] || echo "nothing was kept"
    echo "dawnr sends nothing anywhere, so there is nothing else to erase (PRIVACY.md)"
    ;;
  doctor)
    echo "dawnr at $DAWNR_REPO, data in $DAWNR_HOME"
    echo "python: $("$DAWNR_PYTHON" -V 2>&1)"
    echo "model server: $(LD_LIBRARY_PATH="$(dirname "$LLAMA_SERVER"):${LD_LIBRARY_PATH:-}" "$LLAMA_SERVER" --version 2>&1 | grep -m1 -i version || echo MISSING) (${DAWNR_BUILD:-cpu} build)"
    for f in "$STUDENT_GGUF" "$BASE_GGUF"; do
      [ -s "$f" ] && echo "model: $(basename "$f") ($(du -Lh "$f" | cut -f1))" || echo "model: $(basename "$f") MISSING"
    done
    if [ -n "${T_DAFNY:-}" ] && ! out=$("$T_DAFNY" --version 2>&1); then echo "dafny: CANNOT RUN: ${out%%$'\n'*}"; fi
    if command -v pdftotext >/dev/null; then echo "PDFs: read with pdftotext"
    elif PYTHONPATH="$DAWNR_HOME/pylib" "$DAWNR_PYTHON" -c 'import pypdfium2; pypdfium2.PdfDocument.new()' >/dev/null 2>&1; then echo "PDFs: read with PDFium (dawnr's own copy)"
    else echo "PDFs: NO READER (run install.sh again, or install poppler)"; fi
    if why=$(sandbox_check); then
      [ "$(uname -s)" = Linux ] && echo "sandbox: bubblewrap, runs" || echo "sandbox: macOS Seatbelt (sandbox-exec), runs"
    else echo "sandbox: CANNOT RUN: $why"; fi
    cd "$DAWNR_REPO" && "$DAWNR_PYTHON" - <<'PY'
import sys
sys.path.insert(0, "t")
import run_par
cols, present = run_par.probe_backends()
print(f"provers: {len(present)} of {len(cols)} found")
for name, ver in cols:
    print(f"  {name}: {ver if not str(ver).startswith('ABSENT') else 'not installed'}")
PY
    ;;
  *) sed -n '2,24p' "$0";;
esac
