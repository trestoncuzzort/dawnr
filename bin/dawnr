#!/usr/bin/env bash
# dawnr: one question through the whole gate, offline, on this machine.
#
#   dawnr ask "Write a function that doubles a number." --test "assert double(3) == 6" [--test ...] [--answers N]
#   dawnr doctor          what is installed and what each part found
#   dawnr serve start     keep the two model servers running between questions (faster); serve stop / serve status
#
# Installed by install.sh. The gate is t/answer.py: the student answers, the answers that pass the tests are checked
# against an independent Python solution, then proved; one is shown with its evidence, or the question is refused.
set -euo pipefail
ENVF=${DAWNR_HOME:-$HOME/.local/share/dawnr}/env
[ -f "$ENVF" ] || { echo "dawnr: not installed yet; run install.sh from the dawnr folder" >&2; exit 1; }
set -a; . "$ENVF"; set +a
CORES=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
THREADS=${DAWNR_THREADS:-$(( CORES > 2 ? CORES / 2 : 1 ))}
SP=${DAWNR_STUDENT_PORT:-8711}; BP=${DAWNR_BASE_PORT:-8712}
RUN=$DAWNR_HOME/run; mkdir -p "$RUN"

healthy() { curl -s -m 2 "http://127.0.0.1:$1/health" 2>/dev/null | grep -q '"ok"'; }

# --cache-ram 256: llama-server keeps up to 8 GiB of old prompts in RAM by default, a speed feature for switching
# between prompts (github.com/ggml-org/llama.cpp/pull/16391); dawnr repeats one prompt, which the slot reuses anyway,
# and the default pushed the student's server to 10.8 GB (measured 2026-10-02)
start_one() {  # name gguf port
  healthy "$3" && return 0
  [ -s "$2" ] || { echo "dawnr: the $1 model is missing ($2); run install.sh" >&2; exit 1; }
  # DAWNR_GPU_LAYERS: how many layers llama.cpp puts on the GPU (unset: its own choice; 0: CPU only)
  nohup "$LLAMA_SERVER" --model "$2" --host 127.0.0.1 --port "$3" --threads "$THREADS" --threads-batch "$THREADS" \
    ${DAWNR_GPU_LAYERS:+--n-gpu-layers "$DAWNR_GPU_LAYERS"} \
    --ctx-size 4096 --parallel 1 --reasoning off --cache-ram 256 --no-webui > "$RUN/$1.log" 2>&1 < /dev/null &
  echo $! > "$RUN/$1.pid"
}

wait_ready() {  # a first start on a small machine loads 7 GB and compiles its kernels: GitHub's 3-core Mac took over 3 minutes
  local limit=${DAWNR_START_SECONDS:-600} i n pid
  for i in $(seq 1 "$limit"); do
    healthy "$SP" && healthy "$BP" && return 0
    for n in student base; do
      pid=$(cat "$RUN/$n.pid" 2>/dev/null || true)
      if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        echo "dawnr: the $n model server stopped while loading; the end of $RUN/$n.log:" >&2; tail -5 "$RUN/$n.log" >&2; return 1
      fi
    done
    [ $((i % 60)) = 0 ] && echo "  still loading the models ($i s)..." >&2
    sleep 1
  done
  echo "dawnr: the model servers did not come up in $limit s; see $RUN/*.log" >&2; return 1
}

stop_all() {
  for n in student base; do
    if [ -f "$RUN/$n.pid" ]; then kill "$(cat "$RUN/$n.pid")" 2>/dev/null || true; rm -f "$RUN/$n.pid"; fi
  done
}

sandbox_check() {  # prints why model-written Python cannot be sandboxed here, and fails; silent when it can
  (cd "$DAWNR_REPO" && "$DAWNR_PYTHON" -c 'import sys; sys.path.insert(0, "t"); import py_sandbox
ok = py_sandbox.available(); ok or print(py_sandbox.why_unavailable()); sys.exit(0 if ok else 1)')
}

cmd=${1:-help}; shift || true
case $cmd in
  ask)
    [ $# -ge 1 ] && [ "${1#--}" = "$1" ] || { echo 'usage: dawnr ask "QUESTION" --test "assert f(x) == y" [--test ...]' >&2; exit 2; }
    QUESTION=$1; shift
    why=$(sandbox_check) || { echo "dawnr: model-written Python only runs in a sandbox, and $why" >&2; exit 1; }
    started=0
    if ! { healthy "$SP" && healthy "$BP"; }; then
      echo "starting the models (half a minute here, a few minutes the first time on a small machine)..." >&2
      start_one student "$STUDENT_GGUF" "$SP"; start_one base "$BASE_GGUF" "$BP"; started=1
      trap '[ $started = 1 ] && stop_all' EXIT
      wait_ready
    fi
    cd "$DAWNR_REPO"
    # --consistency 5: five more Python solutions sampled at 0.8 must not find the specification false
    # (t/PREDICT-2026-10-02-ambiguity.md: 80% -> 87% of shown answers right); a later --consistency overrides it
    T_MIN_KERNELS=${T_MIN_KERNELS:-1} "$DAWNR_PYTHON" t/answer.py --student "127.0.0.1:$SP" --python "127.0.0.1:$BP" \
      --consistency 5 --text "$QUESTION" "$@"
    ;;
  serve)
    case ${1:-status} in
      start) start_one student "$STUDENT_GGUF" "$SP"; start_one base "$BASE_GGUF" "$BP"; wait_ready && echo "the models are up";;
      stop) stop_all; echo "stopped";;
      status) for p in "$SP" "$BP"; do healthy "$p" && echo "port $p: up" || echo "port $p: down"; done;;
      *) echo "dawnr serve start|stop|status" >&2; exit 2;;
    esac;;
  doctor)
    echo "dawnr at $DAWNR_REPO, data in $DAWNR_HOME"
    echo "python: $("$DAWNR_PYTHON" -V 2>&1)"
    echo "model server: $("$LLAMA_SERVER" --version 2>&1 | grep -m1 -i version || echo MISSING)"
    for f in "$STUDENT_GGUF" "$BASE_GGUF"; do
      [ -s "$f" ] && echo "model: $(basename "$f") ($(du -Lh "$f" | cut -f1))" || echo "model: $(basename "$f") MISSING"
    done
    if why=$(sandbox_check); then
      [ "$(uname -s)" = Linux ] && echo "sandbox: bubblewrap, runs" || echo "sandbox: macOS Seatbelt (sandbox-exec), runs"
    else echo "sandbox: CANNOT RUN: $why"; fi
    cd "$DAWNR_REPO" && "$DAWNR_PYTHON" - <<'PY'
import sys
sys.path.insert(0, "t")
import run_par
cols, present = run_par.probe_backends()
print(f"provers: {len(present)} of {len(cols)} found")
for name, ver in cols:
    print(f"  {name}: {ver if not str(ver).startswith('ABSENT') else 'not installed'}")
PY
    ;;
  *) sed -n '2,8p' "$0";;
esac
