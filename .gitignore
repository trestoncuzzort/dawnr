# VM images, model weights, fuzz outputs and report PDFs. Regenerable or too large for git.
/models/
/tup-vm/
/t-corpora/
/t-kernel-artifacts/
/tup-reports/
/t-truth-fuzz*/
/nl-problems/

# Graft deep-pass provider config (Bedrock API key). Private, never committed.
/.env.graft

# nl/: APPS and CodeContests are not shipped (problem statements under the judges' copyright); fetched locally, verified by nl/scripts/verify_manifest.py
nl/data/apps_raw_*.jsonl.gz
nl/data/codecontests_*.jsonl.gz
# t lab's per-step process files and generated sudo scripts
t/runs/*/logs/*.pid
t/runs/*/logs/*.sh

# the machine that grades, which is nobody else's business
t/lab-workstation.conf

# Run state, when locallm is running from the folder it lives in. t/paths.py
# prefers a locallm-data/ beside the program over the platform's own cache, so a
# stick carries its own state and leaves nothing on a borrowed machine -- which
# means on a normal checkout it lands here, inside a public repository. It holds
# the event stream, scratch files and the window geometry: machine-shaped, not
# ours to publish.
/locallm-data/

# personal drafts that live beside the work, never in it
MARKET_REALITY.md
RESPONSE_TO_CLAUDE.md
generate_pitch.py
send_pitch.py
email_founders.py

# Build output. locallm/release.py assembles it from the tree; it is reproducible
# by construction, so committing it would only be a large duplicate.
/dist/
